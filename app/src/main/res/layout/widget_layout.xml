<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_note"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/widgetTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- Search Icon Action -->
        <ImageView
            android:id="@+id/widgetSearchBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@drawable/ic_widget_search"
            android:contentDescription="@string/widget_search"
            android:alpha="0.85" />

        <!-- Quick Add Note Icon Action -->
        <ImageView
            android:id="@+id/widgetQuickAddBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="@string/widget_new_note"
            android:alpha="0.85" />
    </LinearLayout>

    <!-- Content container: List + Empty View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widgetNotesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <!-- Empty state card -->
        <LinearLayout
            android:id="@+id/widgetEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_widget_note"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/widgetEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_title"
                android:textColor="#E0E7FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/widgetEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_subtitle"
                android:textColor="#99A5B4FC"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Superpower Quick Actions Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp">

        <!-- 1. Voice Record -->
        <LinearLayout
            android:id="@+id/widgetRecordBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_button_bg"
            android:paddingVertical="9dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_mic" />

            <TextView
                android:id="@+id/widgetRecordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_record"
                android:textSize="10sp"
                android:textColor="#E6FFFFFF"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 2. New Note -->
        <LinearLayout
            android:id="@+id/widgetNoteBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_button_bg"
            android:paddingVertical="9dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_note" />

            <TextView
                android:id="@+id/widgetNoteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_new_note"
                android:textSize="10sp"
                android:textColor="#E6FFFFFF"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 3. Ask AI (On-Device RAG Chat) -->
        <LinearLayout
            android:id="@+id/widgetChatBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_button_bg"
            android:paddingVertical="9dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_chat" />

            <TextView
                android:id="@+id/widgetChatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_ask_ai"
                android:textSize="10sp"
                android:textColor="#E6FFFFFF"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
